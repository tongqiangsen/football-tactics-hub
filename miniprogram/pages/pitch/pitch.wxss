/** miniprogram/pages/pitch/pitch.wxss **/
.container {
  padding: 24rpx;
  background-color: #0a0e0c;
  min-height: 100vh;
}

/* Formation Tabs */
.formation-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.tab-btn {
  display: inline-block;
  padding: 14rpx 28rpx;
  background: #141c18;
  color: #94a3b8;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.tab-btn.active {
  background: #1a2420;
  color: #10b981;
  border-color: #10b981;
  font-weight: bold;
}

/* Pitch Card */
.pitch-card {
  background: #141c18;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.pitch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.pitch-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #f8fafc;
}
.pitch-tag {
  font-size: 20rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1px solid rgba(245, 158, 11, 0.25);
}

/* Toolbar */
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #1a2420;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  margin-bottom: 20rpx;
}
.tool-modes, .tool-actions {
  display: flex;
  gap: 10rpx;
}
.tool-pill {
  font-size: 22rpx;
  padding: 8rpx 14rpx;
  background: #141c18;
  color: #94a3b8;
  border-radius: 8rpx;
  border: 1px solid rgba(255, 255, 255, 0.06);
}
.tool-pill.active {
  background: rgba(16, 185, 129, 0.2);
  color: #10b981;
  border-color: #10b981;
  font-weight: bold;
}
.action-pill {
  font-size: 20rpx;
  padding: 8rpx 12rpx;
  background: #141c18;
  color: #94a3b8;
  border-radius: 8rpx;
}
.action-pill.gold {
  color: #f59e0b;
}

/* Pitch Board */
.pitch-board {
  position: relative;
  width: 100%;
  height: 640rpx;
  background: #071911;
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 16rpx;
  overflow: hidden;
}
.pitch-line {
  position: absolute;
  border-color: rgba(255, 255, 255, 0.25);
  border-style: solid;
}
.half-line {
  top: 50%; left: 0; width: 100%; height: 1px;
  border-top-width: 2rpx;
}
.pitch-circle {
  position: absolute;
  top: 50%; left: 50%;
  width: 140rpx; height: 140rpx;
  transform: translate(-50%, -50%);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 50%;
}
.pitch-spot {
  position: absolute;
  top: 50%; left: 50%;
  width: 10rpx; height: 10rpx;
  transform: translate(-50%, -50%);
  background: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
}
.pitch-box {
  position: absolute;
  left: 50%;
  width: 260rpx; height: 120rpx;
  transform: translateX(-50%);
  border: 2rpx solid rgba(255, 255, 255, 0.25);
}
.penalty-top { top: 0; border-top-width: 0; }
.penalty-bottom { bottom: 0; border-bottom-width: 0; }

.pitch-canvas {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 6;
}
.pitch-canvas.pointer-none {
  pointer-events: none;
}

/* Player Nodes */
.player-node {
  position: absolute;
  width: 58rpx;
  height: 58rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #ffffff;
  border: 4rpx solid #0f172a;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.6);
}
.player-node.active {
  background: #10b981;
  border-color: #ffffff;
  transform: translate(-50%, -50%) scale(1.15);
  box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.5);
  z-index: 12;
}
.player-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1;
}
.player-node.active .player-num {
  color: #ffffff;
}
.player-pos {
  position: absolute;
  bottom: -28rpx;
  font-size: 18rpx;
  font-weight: bold;
  color: #f1f5f9;
  background: rgba(15, 23, 42, 0.85);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

/* Scenario Bar */
.scenario-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 10rpx 14rpx;
  background: rgba(16, 185, 129, 0.06);
  border: 1px dashed rgba(16, 185, 129, 0.25);
  border-radius: 12rpx;
}
.scenario-label {
  font-size: 22rpx;
  color: #10b981;
  font-weight: bold;
}
.scenario-pill {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  background: #141c18;
  color: #94a3b8;
  border-radius: 8rpx;
  border: 1px solid rgba(255, 255, 255, 0.08);
}
.scenario-pill.active {
  background: #10b981;
  color: #000;
  font-weight: bold;
  border-color: #10b981;
}

/* Role Card */
.role-card {
  background: #141c18;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 24rpx;
}
.role-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
}
.role-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #f8fafc;
}
.role-code {
  font-size: 22rpx;
  color: #f59e0b;
  margin-top: 4rpx;
  display: block;
}
.num-badge {
  font-size: 22rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-weight: bold;
}
.duty-box {
  background: #1a2420;
  border-left: 6rpx solid #10b981;
  padding: 16rpx;
  border-radius: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #f8fafc;
  margin-bottom: 20rpx;
}
.stepper {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.step-item {
  background: #1a2420;
  padding: 16rpx;
  border-radius: 12rpx;
}
.step-tag {
  font-size: 22rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 6rpx;
}
.step-item.pre .step-tag { color: #10b981; }
.step-item.main .step-tag { color: #f59e0b; }
.step-item.post .step-tag { color: #38bdf8; }
.step-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}
.meta-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.meta-card {
  background: #1a2420;
  padding: 14rpx;
  border-radius: 12rpx;
}
.meta-label {
  font-size: 20rpx;
  color: #64748b;
  display: block;
  margin-bottom: 4rpx;
}
.meta-val {
  font-size: 22rpx;
  color: #f8fafc;
  font-weight: 500;
}
